DISCORD_TOKEN=INSERT_DISCORD_BOT_TOKEN_HERE

# insert channel id or keyword(case-insensetive,will check if the word is included in the channel name) in the target rules variable with
# an type in this format chan.id/keyword:enforcement:mode
# First part of the type "enforcement":
#
#    0:x=warning only (literally enforcive, but it will not actually kick anyone)
#
#    1:x=enforcive 
#
#
#    Second part of the type, "mode":
#
#    x:0= keyword or channel id would be monitered for cam or ss (either or both are valid)
#
#    x:1= // will be monitered for cam only
#
#    x:2= // will be monitered for ss only 
#
#
# example=TARGET_RULES="1234567891011121314:1:0,study:0:1,stream:1:2" 
#

TARGET_RULES="INSERT_TARGET_RULES_HERE"

# Disconnect grace period in seconds
GRACE_PERIOD_SECONDS=20
